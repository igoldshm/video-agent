# Copy to .env and fill in. Never commit the real file.
DIRECTORCUT_ACCESS_CODE=            # anyone with this code can make videos on your account
REPLICATE_API_TOKEN=            # video generation; without it the app runs in demo mode
ANTHROPIC_API_KEY=              # planner and vision judge
# owner/name=estimated price per second, in order of preference. Set prices from each model's page.
DIRECTORCUT_VIDEO_MODELS=wan-video/wan-2.2-t2v-fast=0.02,wan-video/wan-2.5-t2v-fast=0.06
# Optional: consistent subjects. A reference image is drawn and approved, then each shot gets its
# own opening frame made from it. Both are owner/name=estimated price per image. With these set,
# put an image-to-video model first in DIRECTORCUT_VIDEO_MODELS and keep a text-to-video one as fallback.
DIRECTORCUT_IMAGE_MODEL=            # text-to-image, e.g. black-forest-labs/flux-schnell=0.003
DIRECTORCUT_KEYFRAME_MODEL=         # image editing with a reference input, e.g. black-forest-labs/flux-kontext-pro=0.04
DIRECTORCUT_LLM_MODEL=claude-sonnet-5-5
DIRECTORCUT_BUDGET_USD=3            # video-generation spend allowed per video
DIRECTORCUT_DAILY_USD=15            # new videos are refused once today's spend reaches this
DIRECTORCUT_DAILY_VIDEOS=20
DIRECTORCUT_MAX_SECONDS=15          # longest video a creator can ask for
DIRECTORCUT_MAX_SHOT_SECONDS=5
DIRECTORCUT_HOME=.directorcut           # database and media; point at a persistent disk in production
